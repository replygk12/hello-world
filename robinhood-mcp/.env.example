# Copy to .env (same directory) and fill in. Never commit .env.

# Required: Robinhood login credentials.
RH_USERNAME=you@example.com
RH_PASSWORD=your-password

# Optional MFA (pick one). RH_TOTP_SECRET is preferred: it is the base32 secret
# shown when you set up an authenticator app in Robinhood, and a fresh code is
# generated on every login. RH_MFA_CODE is a one-off 6-digit code and goes stale
# within ~30 seconds, so it is only useful for a single manual login.
RH_TOTP_SECRET=
RH_MFA_CODE=

# Optional: where robin_stocks stores the session pickle (default: ~/.tokens)
# and a suffix for the file name (robinhood<NAME>.pickle), useful for multiple accounts.
RH_PICKLE_PATH=
RH_PICKLE_NAME=

# Optional: requested session lifetime in seconds (default: 86400).
RH_SESSION_EXPIRES=86400
